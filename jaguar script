local espData = {}

local function destroyESP(plr)
    local data = espData[plr]
    if data then
        if data.Name then data.Name:Destroy() end
        espData[plr] = nil
    end
end

local function isESPAlive(plr)
    local data = espData[plr]
    if not data then return false end
    if not data.Name or not data.Name.Parent then return false end
    local adornee = data.Name.Adornee
    if not adornee or not adornee.Parent then return false end
    if not plr.Character or not adornee:IsDescendantOf(plr.Character) then return false end
    return true
end

local function createESP(plr)
    if espData[plr] then
        if isESPAlive(plr) then return end
        destroyESP(plr)
    end
    local char = plr.Character
    if not char then return end
    local wl = getWhitelist()
    if not wl[plr.Name] then return end
    local head       = char:FindFirstChild("Head")
    local root       = char:FindFirstChild("HumanoidRootPart")
    local adornTarget = head or root
    if not adornTarget then return end

    local nameTag = Instance.new("BillboardGui")
    nameTag.Adornee      = adornTarget
    nameTag.Size         = UDim2.new(0, 200, 0, 30)
    nameTag.StudsOffset  = Vector3.new(0, -3.5, 0)
    nameTag.AlwaysOnTop  = true
    nameTag.Name         = "ESPName"
    nameTag.Parent       = char

    local label = Instance.new("TextLabel")
    label.Size                    = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency  = 1
    label.Text                    = plr.DisplayName or plr.Name
    label.TextColor3              = Color3.fromRGB(255, 255, 255)
    label.TextSize                = Config.ESP.Size
    label.Font                    = Enum.Font.SourceSansBold
    label.TextStrokeColor3        = Color3.fromRGB(0, 0, 0)
    label.TextStrokeTransparency  = 0.3
    label.Parent                  = nameTag

    espData[plr] = { Name = nameTag, Label = label }
end

local function updateESP()
    if not espEnabled then
        for plr, _ in pairs(espData) do destroyESP(plr) end
        return
    end
    local players = Players:GetPlayers()
    local wl      = getWhitelist()
    for _, plr in ipairs(players) do
        if plr == player then destroyESP(plr) continue end
        if wl[plr.Name] then
            if plr.Character and plr.Character.Parent then
                if not isESPAlive(plr) then createESP(plr) end
            else
                if espData[plr] then destroyESP(plr) end
            end
        else
            destroyESP(plr)
        end
    end
    for plr, _ in pairs(espData) do
        if not plr.Parent then destroyESP(plr) end
    end
end

