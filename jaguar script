local function getWhitelist() return Config.Triggerbot.Whitelist.List end

local function isKnocked(char)
    local be = char:FindFirstChild("BodyEffects")
    return be and be:FindFirstChild("K.O") and be["K.O"].Value == true
end

local function isGrabbed(char)
    return char:FindFirstChild("GRABBING_CONSTRAINT") ~= nil
end

local function hasLineOfSight(targetRoot)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = { player.Character }
    local direction = (targetRoot.Position - Camera.CFrame.Position).Unit
    local distance  = (targetRoot.Position - Camera.CFrame.Position).Magnitude
    local result    = Workspace:Raycast(Camera.CFrame.Position, direction * distance, params)
    if result then
        local hit = result.Instance
        return hit and hit:IsDescendantOf(targetRoot.Parent)
    end
    return false
end

local function isKnife(tool)
    if not tool then return false end
    local name = tool.Name
    for _, knifeName in ipairs(Config.Triggerbot.KnifeNames) do
        if name:lower():find(knifeName:lower()) then return true end
    end
    return false
end

local function GetClosestPartToCursor(Character)
    local closest, dist = nil, math.huge
    local mousePos = UserInputService:GetMouseLocation()
    for _, part in ipairs(Character:GetChildren()) do
        if part:IsA("BasePart") then
            local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
            if onScreen then
                local mag = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                if mag < dist then
                    dist    = mag
                    closest = part
                end
            end
        end
    end
    return closest
end

local function GetClosestPointOnPart(Part, Scale)
    if not Part then return Vector3.new(0, 0, 0) end
    local partCF  = Part.CFrame
    local size    = Part.Size * (Scale / 2)
    local mousePos = UserInputService:GetMouseLocation()
    local ray      = Camera:ViewportPointToRay(mousePos.X, mousePos.Y)
    local localPoint = partCF:PointToObjectSpace(
        ray.Origin + ray.Direction * (ray.Direction:Dot(partCF.Position - ray.Origin))
    )
    return partCF * Vector3.new(
        math.clamp(localPoint.X, -size.X, size.X),
        math.clamp(localPoint.Y, -size.Y, size.Y),
        math.clamp(localPoint.Z, -size.Z, size.Z)
    )
end

local function GetClosestPointOnPartBasic(Part)
    return Part and Part.Position or Vector3.new(0, 0, 0)
end

local function IsTargetValidForCamlock(Target)
    if not Target or not Target.Character then return false end
    if isProtected(Target, player) then return false end
    local char = Target.Character
    local hum  = char:FindFirstChild("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local wl = getWhitelist()
    if not wl[Target.Name] then return false end
    if isKnocked(char) then return false end
    local camlockChecks = Config.Camlock.Checks
    if camlockChecks.Wall then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root and not hasLineOfSight(root) then return false end
    end
    if camlockChecks.Knife then
        local tool = char:FindFirstChildOfClass("Tool")
        if tool and isKnife(tool) then return false end
    end
    return true
end

local function GetBestTarget()
    local best, bestDist = nil, Config.Camlock.FOV.Size or 200
    local mousePos = UserInputService:GetMouseLocation()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == player then continue end
        if not IsTargetValidForCamlock(plr) then continue end
        local root = plr.Character:FindFirstChild("HumanoidRootPart")
        if not root then continue end
        local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
        if not onScreen then continue end
        local mag = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
        if mag < bestDist then
            bestDist = mag
            best     = plr
        end
    end
    return best
end

local function GetHitPosition(Target)
    if not Target or not Target.Character then return Vector3.new(0, 0, 0) end
    local char = Target.Character
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return Vector3.new(0, 0, 0) end
    local cfg  = Config.Camlock
    local part = GetClosestPartToCursor(char)
    local targetPos = root.Position
    if cfg.Point == "Nearest Part" then
        targetPos = part and part.Position or root.Position
    elseif cfg.Point == "Nearest Point" then
        if cfg.Type == "Advanced" then
            targetPos = GetClosestPointOnPart(part, cfg.Scale)
        else
            targetPos = GetClosestPointOnPartBasic(part)
        end
    else
        local specific = char:FindFirstChild(cfg.Point)
        targetPos = specific and specific.Position or root.Position
    end
    if cfg.Prediction.Enabled then
        local vel     = root.AssemblyLinearVelocity
        local predVal = (char.Humanoid:GetState() == Enum.HumanoidStateType.Freefall or
                         char.Humanoid:GetState() == Enum.HumanoidStateType.Jumping)
                        and cfg.Prediction.Air or cfg.Prediction.Ground
        targetPos = targetPos + vel * predVal
    end
    return targetPos
end

local function CamlockChecksPassed()
    local checks      = Config.Camlock.Checks
    local zoom        = (Camera.CFrame.Position - Camera.Focus.Position).Magnitude
    local isFirstPerson = zoom < 1
    local isThirdPerson = zoom >= 1
    local rightClick  = UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
    if checks.FirstPerson and not isFirstPerson then return false end
    if checks.ThirdPerson and not isThirdPerson  then return false end
    if checks.RightClicking and not rightClick   then return false end
    return true
end

local function runCamlock()
    local isAlways = Config.Camlock.Smoothing.Always
    if isAlways then
        if not Config.Camlock.Enabled then return end
        if not CamlockChecksPassed() then return end
        local char = player.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool and isKnife(tool) then return end
        end
        if not camlockTarget or not IsTargetValidForCamlock(camlockTarget) then
            camlockTarget = GetBestTarget()
            if not camlockTarget then return end
        end
        if not IsTargetValidForCamlock(camlockTarget) then
            camlockTarget = nil
            return
        end
        local targetPos          = GetHitPosition(camlockTarget)
        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)
        if not onScreen then camlockTarget = nil return end
        local mousePos = UserInputService:GetMouseLocation()
        if (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude > Config.Camlock.FOV.Size then
            camlockTarget = nil
            return
        end
        local smooth = 1
        if Config.Camlock.Smoothing.Enabled then
            local state = camlockTarget.Character.Humanoid:GetState()
            smooth = (state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall)
                     and Config.Camlock.Smoothing.Air or Config.Camlock.Smoothing.Ground
        end
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetPos), smooth)
    else
        if not Config.Camlock.Enabled then return end
        if not camlockActive then return end
        if not CamlockChecksPassed() then return end
        local char = player.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool and isKnife(tool) then return end
        end
        if not (Config.Camlock.Sticky and stickyActive) then
            camlockTarget = GetBestTarget()
        end
        if not camlockTarget then return end
        if not IsTargetValidForCamlock(camlockTarget) then
            camlockTarget = nil
            stickyActive  = false
            return
        end
        local targetPos          = GetHitPosition(camlockTarget)
        local screenPos, onScreen = Camera:WorldToViewportPoint(targetPos)
        if not onScreen then return end
        local mousePos = UserInputService:GetMouseLocation()
        if (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude > Config.Camlock.FOV.Size then return end
        local smooth = 1
        if Config.Camlock.Smoothing.Enabled then
            local state = camlockTarget.Character.Humanoid:GetState()
            smooth = (state == Enum.HumanoidStateType.Jumping or state == Enum.HumanoidStateType.Freefall)
                     and Config.Camlock.Smoothing.Air or Config.Camlock.Smoothing.Ground
        end
        Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, targetPos), smooth)
    end
end

local function getClosestPlayerForTrigger()
    local closest     = nil
    local closestDist = math.huge
    local mousePos    = Vector2.new(mouse.X, mouse.Y)
    local wl          = getWhitelist()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == player then continue end
        if isProtected(plr, player) then continue end
        if not wl[plr.Name] then continue end
        local char = plr.Character
        if not char or not char.Parent then continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        if not root then continue end
        local checks = Config.Triggerbot.Hitbox.Checks
        local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if myRoot then
            local dist = (root.Position - myRoot.Position).Magnitude
            if dist > checks.MaxDistance then continue end
        end
        if checks.SelfKnocked and player.Character and isKnocked(player.Character) then continue end
        if checks.Knocked  and isKnocked(char)  then continue end
        if checks.Grabbed  and isGrabbed(char)  then continue end
        if checks.ForceField and char:FindFirstChild("ForceField") then continue end
        if checks.Visible  and not hasLineOfSight(root) then continue end
        local screenPos, onScreen = Camera:WorldToViewportPoint(root.Position)
        if not onScreen then continue end
        local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
        if dist < closestDist then
            closestDist = dist
            closest     = plr
        end
    end
    return closest
end

local function runTriggerbot()
    if not Config.Triggerbot.Enabled then return end
    local target = getClosestPlayerForTrigger()
    if not target then return end
    local tool = player.Character and player.Character:FindFirstChildOfClass("Tool")
    if not tool then return end
    if isKnife(tool) then return end
    if Config.Triggerbot.Hitbox.Enabled then
        if mouse.Target and mouse.Target:IsDescendantOf(target.Character) then
            if triggerActive then
                pcall(function() tool:Activate() end)
            end
        end
    end
end

local function setupTriggerbotKeybind()
    local cfg    = Config.Triggerbot
    local key    = cfg.Key
    local isMouse = cfg.InputType == "Mouse"
    local keyEnum = isMouse and Enum.UserInputType[key] or Enum.KeyCode[key]
    if not keyEnum then return end
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        local match = isMouse and input.UserInputType == keyEnum or input.KeyCode == keyEnum
        if not match then return end
        if cfg.Type == "Hold" then
            triggerActive = true
        else
            triggerActive = not triggerActive
        end
    end)
    if cfg.Type == "Hold" then
        UserInputService.InputEnded:Connect(function(input, gameProcessed)
            if gameProcessed then return end
            local match = isMouse and input.UserInputType == keyEnum or input.KeyCode == keyEnum
            if match then triggerActive = false end
        end)
    end
end

