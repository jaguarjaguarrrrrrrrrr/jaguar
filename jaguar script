local function isCurrentWeaponKnife()
    local char = player.Character
    if not char then return true end
    local tool = char:FindFirstChildOfClass("Tool")
    return isKnife(tool)
end

local function advanceStage()
    if currentStage == "DB" then
        currentStage = "Tactical"
        equipSlot(3)
    elseif currentStage == "Tactical" then
        currentStage   = "Revolver"
        revolverShots  = 0
        equipSlot(2)
    elseif currentStage == "Revolver" then
        revolverShots = revolverShots + 1
        if revolverShots >= 45 then
            currentStage  = "DB"
            revolverShots = 0
            task.wait(0.05)
            equipSlot(1)
        end
    end
end

local function onShot()
    if not autoSwitchEnabled then return end
    if isCurrentWeaponKnife() then return end
    if currentStage == "DB"       and currentSlot == 1 then advanceStage()
    elseif currentStage == "Tactical"  and currentSlot == 3 then advanceStage()
    elseif currentStage == "Revolver"  and currentSlot == 2 then advanceStage()
    end
end

local function setupToolListener(char)
    if shotConnection     then shotConnection:Disconnect()     end
    if toolChildAddedCon  then toolChildAddedCon:Disconnect()  end
    if toolChildRemovedCon then toolChildRemovedCon:Disconnect() end
    shotConnection     = nil
    currentTool        = nil
    if not char then return end
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        shotConnection = tool.Activated:Connect(onShot)
        currentTool    = tool
    end
    toolChildAddedCon = char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then
            if shotConnection then shotConnection:Disconnect() end
            shotConnection = child.Activated:Connect(onShot)
            currentTool    = child
        end
    end)
    toolChildRemovedCon = char.ChildRemoved:Connect(function(child)
        if child == currentTool then
            if shotConnection then shotConnection:Disconnect() end
            shotConnection = nil
            currentTool    = nil
        end
    end)
end

