local function removeHitboxVisual(root)
    if not root then return end
    local existing = root:FindFirstChild("HitboxVisual")
    if existing then existing:Destroy() end
end

local function updateHitboxVisual(root)
    if not root then return end
    local existing = root:FindFirstChild("HitboxVisual")
    if not existing or not existing:IsA("BoxHandleAdornment") then
        if existing then existing:Destroy() end
        existing           = Instance.new("BoxHandleAdornment")
        existing.Name      = "HitboxVisual"
        existing.AlwaysOnTop = true
        existing.ZIndex    = 5
        existing.Parent    = root
    end
    existing.Adornee      = root
    existing.Size         = root.Size
    existing.Color3       = Config.HitboxExpander.Color or Color3.fromRGB(255, 60, 60)
    existing.Transparency = Config.HitboxExpander.Transparency or 0.5
end

local function getMuzzlePosition()
    local char = player.Character
    if not char then return nil end
    local tool = char:FindFirstChildOfClass("Tool")
    if not tool then return nil end
    local handle = tool:FindFirstChild("Handle")
    if not handle then return nil end
    local muzzle = handle:FindFirstChild("Muzzle")
    if muzzle and muzzle:IsA("Attachment") then return muzzle.WorldPosition end
    local muzzlePart = handle:FindFirstChild("Muzzle")
    if muzzlePart and muzzlePart:IsA("BasePart") then return muzzlePart.Position end
    return handle.Position
end

local DEFAULT_HRP_SIZE = Vector3.new(2, 2, 2)
local originalSizes    = {}
local expandedSizes    = {}
local bypassHooked     = false
local originalEmit     = nil

local function snapshotOriginalSize(root)
    if not originalSizes[root] then
        originalSizes[root] = (root.Size == DEFAULT_HRP_SIZE) and DEFAULT_HRP_SIZE or root.Size
    end
end

local function withOriginalSize(root, callback)
    if not root or not root.Parent then callback() return end
    local expanded = expandedSizes[root] or root.Size
    local original = originalSizes[root] or DEFAULT_HRP_SIZE
    root.Size = original
    callback()
    root.Size = expanded
end

local function setupBloodBypassHook()
    if bypassHooked then return end
    originalEmit = hookfunction(Instance.new("ParticleEmitter").Emit, newcclosure(function(self, count)
        if not Config.HitboxExpander.BloodBypass then
            return originalEmit(self, count)
        end
        local part = self.Parent
        local root = nil
        for _ = 1, 6 do
            if not part then break end
            if part:IsA("BasePart") and expandedSizes[part] then
                root = part
                break
            end
            part = part.Parent
        end
        if root then
            withOriginalSize(root, function()
                originalEmit(self, count)
            end)
        else
            originalEmit(self, count)
        end
    end))
    bypassHooked = true
end

local function teardownBloodBypassHook()
    if not bypassHooked or not originalEmit then return end
    hookfunction(Instance.new("ParticleEmitter").Emit, originalEmit)
    originalEmit = nil
    bypassHooked = false
end

local PreviousHitboxExpander = _G.HitboxExpanderInstance
if PreviousHitboxExpander then
    if PreviousHitboxExpander.Stop then PreviousHitboxExpander.Stop() end
    _G.HitboxExpanderInstance = nil
end

if Config.HitboxExpander.Enabled then
    local instance = {}
    local running  = true

    if Config.HitboxExpander.BloodBypass then
        setupBloodBypassHook()
    end

    instance.Stop = function()
        running = false
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= player and plr.Character then
                local hum  = plr.Character:FindFirstChildOfClass("Humanoid")
                local root = hum and hum.RootPart
                if root then
                    local orig = originalSizes[root] or DEFAULT_HRP_SIZE
                    root.Size       = orig
                    root.CanCollide = true
                    removeHitboxVisual(root)
                    originalSizes[root] = nil
                    expandedSizes[root] = nil
                end
            end
        end
        teardownBloodBypassHook()
    end

    instance.Loop = task.spawn(function()
        while running do
            local wantBypass = Config.HitboxExpander.BloodBypass
            if wantBypass and not bypassHooked then
                setupBloodBypassHook()
            elseif not wantBypass and bypassHooked then
                teardownBloodBypassHook()
            end

            local wl    = getWhitelist()
            local baseX = tonumber(Config.HitboxExpander.X) or 3
            local baseY = tonumber(Config.HitboxExpander.Y) or 3
            local baseZ = tonumber(Config.HitboxExpander.Z) or 3

            local referencePos = getMuzzlePosition()
            if not referencePos then
                local myChar = player.Character
                local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
                referencePos = myRoot and myRoot.Position or nil
            end

            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= player then
                    local char = plr.Character
                    if char then
                        local hum  = char:FindFirstChildOfClass("Humanoid")
                        local root = hum and hum.RootPart
                        if root then
                            if wl[plr.Name] then
                                snapshotOriginalSize(root)
                                local finalX, finalY, finalZ = baseX, baseY, baseZ
                                if referencePos then
                                    local dist    = (referencePos - root.Position).Magnitude
                                    local maxTotal = dist * 1.8
                                    if maxTotal < 4 then maxTotal = 4 end
                                    if finalX > maxTotal then finalX = maxTotal end
                                    if finalY > maxTotal then finalY = maxTotal end
                                    if finalZ > maxTotal then finalZ = maxTotal end
                                end
                                local newSize       = Vector3.new(finalX, finalY, finalZ)
                                expandedSizes[root] = newSize
                                root.CanCollide     = false
                                root.Size           = newSize
                                if Config.HitboxExpander.Visible then
                                    updateHitboxVisual(root)
                                else
                                    removeHitboxVisual(root)
                                end
                            else
                                local orig = originalSizes[root] or DEFAULT_HRP_SIZE
                                root.Size           = orig
                                root.CanCollide     = true
                                originalSizes[root] = nil
                                expandedSizes[root] = nil
                                removeHitboxVisual(root)
                            end
                        end
                    end
                end
            end

            for root, _ in pairs(expandedSizes) do
                if not root or not root.Parent then
                    originalSizes[root] = nil
                    expandedSizes[root] = nil
                end
            end

            task.wait(Config.HitboxExpander.RefreshTime)
        end
    end)

    _G.HitboxExpanderInstance = instance
end

