local function getSpreadCurrentTool()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChildWhichIsA("Tool")
end

local function updateSpreadMultiplier()
    if not Config.SpreadModification.Enabled then
        spreadCurrentMultiplier = 1
        return
    end
    local tool = getSpreadCurrentTool()
    if not tool then
        spreadCurrentMultiplier = 1
        return
    end
    local val = Config.SpreadModification.Guns[tool.Name]
    spreadCurrentMultiplier = (val ~= nil) and val or 1
end

local spreadPatterns = {
    { min = -0.05, max = 0.05 },
    { min = -0.1,  max = 0.1  },
    { min = 0,     max = 0.05 },
    { min = 0,     max = 0.1  },
}

local function isSpreadCall(a, b)
    if a == nil and b == nil then return true end
    if type(a) == "number" and type(b) == "number" then
        for _, pattern in ipairs(spreadPatterns) do
            if math.abs(a - pattern.min) < 0.0001 and math.abs(b - pattern.max) < 0.0001 then
                return true
            end
        end
        local range = math.abs(b - a)
        if range <= 0.2 and a < 0 and b > 0 then return true end
    end
    return false
end

spreadOriginalRandom = hookfunction(math.random, newcclosure(function(...)
    local args = { ... }
    local a, b = args[1], args[2]
    if isSpreadCall(a, b) then
        local raw = spreadOriginalRandom(...)
        return raw * spreadCurrentMultiplier
    end
    return spreadOriginalRandom(...)
end))

